{
  "name": "agent-pigeon",
  "version": "0.1.0",
  "private": true,
  "description": "Proof-of-progress for mobile coding agents.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
