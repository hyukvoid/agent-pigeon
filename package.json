{
  "name": "agent-pigeon",
  "version": "0.2.0",
  "description": "Flight recorder for coding agents. See what your agents changed, where they failed, how they recovered, and what ran in parallel — across Codex, Claude Code, ZCode and Pigeon JSONL. Local, read-only CLI + standalone web UI.",
  "keywords": [
    "coding-agent",
    "claude-code",
    "codex",
    "zcode",
    "opencode",
    "flight-recorder",
    "cli",
    "session",
    "replay",
    "developer-tools"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "ui": "npm run build && node dist/src/cli.js ui",
    "demo": "npm run build && node dist/src/poc00-demo.js",
    "share": "npm run build && node dist/src/cli.js share",
    "governor:process": "npm run build && node dist/experimental/src/governor-process.js",
    "research:corpus": "npm run build && node --max-old-space-size=4096 dist/src/poc04b.js",
    "poc:03": "npm run build && node dist/experimental/src/poc03-worker.js",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "agent-device": "^0.21.8",
    "typescript": "5.9.3"
  },
  "bin": {
    "agent-pigeon": "dist/src/cli.js"
  },
  "files": [
    "dist/src/cli.js",
    "dist/src/flight.js",
    "dist/src/compare.js",
    "dist/src/share.js",
    "dist/src/session.js",
    "dist/src/core",
    "dist/src/replay",
    "dist/src/pigeon",
    "dist/src/adapters",
    "dist/src/ui",
    "ui",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyukvoid/agent-pigeon.git"
  },
  "bugs": {
    "url": "https://github.com/hyukvoid/agent-pigeon/issues"
  },
  "homepage": "https://github.com/hyukvoid/agent-pigeon#readme"
}
