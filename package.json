{
  "name": "agent-pigeon",
  "version": "0.1.1",
  "description": "See how your coding agent actually worked. Local, read-only CLI that turns Claude Code / Codex sessions into flight reports: edits, recognized verification runs, FAIL-to-PASS loops, and session comparisons.",
  "keywords": [
    "claude-code",
    "codex",
    "cli",
    "session",
    "replay",
    "verification",
    "developer-tools"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "demo": "npm run build && node dist/src/poc00-demo.js",
    "share": "npm run build && node dist/src/cli.js share",
    "governor:process": "npm run build && node dist/experimental/src/governor-process.js",
    "research:corpus": "npm run build && node --max-old-space-size=4096 dist/src/poc04b.js",
    "poc:03": "npm run build && node dist/experimental/src/poc03-worker.js",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "agent-device": "^0.21.8",
    "typescript": "5.9.3"
  },
  "bin": {
    "agent-pigeon": "dist/src/cli.js"
  },
  "files": [
    "dist/src/cli.js",
    "dist/src/flight.js",
    "dist/src/compare.js",
    "dist/src/share.js",
    "dist/src/core",
    "dist/src/replay",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyukvoid/agent-pigeon.git"
  },
  "bugs": {
    "url": "https://github.com/hyukvoid/agent-pigeon/issues"
  },
  "homepage": "https://github.com/hyukvoid/agent-pigeon#readme"
}
